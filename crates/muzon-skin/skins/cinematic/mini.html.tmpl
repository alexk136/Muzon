<div class="mini">
  <div class="mini-cover">♪</div>
  <div class="mini-info">
    <div class="mini-eyebrow">{{track_album}}</div>
    <div class="mini-title">{{track_title}}</div>
    <div class="mini-artist">{{track_artist}}</div>
  </div>
  <div class="mini-spectrum" aria-label="Spectrum">{{spectrum_bars}}</div>
  <div class="mini-progress">
    <div class="mini-pbar"><div class="mini-pfill" style="width: {{progress_pct}}%;"></div></div>
  </div>
  <div class="mini-buttons">
    <button class="mini-btn">PRE</button>
    <button class="mini-btn play">{{play_pause_label}}</button>
    <button class="mini-btn">NXT</button>
  </div>
</div>
